# Banco de dados (Postgres) - usado pelo backend e pelo docker-compose para
# subir o container do banco com os mesmos dados.
DB_HOST=db
DB_PORT=5432
DB_NAME=insulinet
DB_USER=insulinet
DB_PASSWORD=insulinet

# Fuso horario usado para resolver datas/horarios de doses e para a janela
# de projecao de consumo. Mesmo nome/valor do backend Python.
APP_TIMEZONE=America/Fortaleza

# JWT. HS256 exige uma chave de pelo menos 32 caracteres (256 bits).
JWT_SECRET_KEY=troque-por-uma-chave-secreta-de-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend (envio do e-mail de recuperacao de senha)
RESEND_API_KEY=
EMAIL_FROM=Insulinet <onboarding@resend.dev>

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Porta HTTP exposta pela aplicacao
PORT=8000
